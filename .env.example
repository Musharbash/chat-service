# Copy to .env and fill in values before running `docker compose up`.
# Empty lines (VAR=) are treated as unset — Zod's optional() will accept them.

# --- Postgres ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=chat

# --- Logging ---
LOG_LEVEL=info

# --- Public ports ---
GATEWAY_PORT=4000
API_PORT=4100

# --- JWT (ES256 keypair) ---
# Generate with:
#   openssl ecparam -genkey -name prime256v1 -noout -out jwt.key
#   openssl ec -in jwt.key -pubout -out jwt.pub
#
# docker-compose.yml bind-mounts ./jwt.key + ./jwt.pub into the containers at
# /run/secrets/jwt.{key,pub} and the services read them from there. You don't
# need to paste the PEMs into env vars — just keep jwt.key and jwt.pub in this
# folder. (To pass PEMs inline instead, set JWT_PRIVATE_KEY / JWT_PUBLIC_KEY
# with literal \n in place of newlines — the config loader will re-expand them.)
JWT_ISSUER=artook-api
JWT_AUDIENCE=artook-chat
SOCKET_TOKEN_TTL_SECONDS=3600

# --- Upstream auth (Pattern A — introspection) ---
# Used if you want the chat-api to verify user bearers by calling back into
# your main API. Leave blank if you're using Pattern B (main API mints JWT
# directly) or smoke-testing.
UPSTREAM_AUTH_INTROSPECT_URL=
UPSTREAM_AUTH_SHARED_SECRET=

# --- Service-to-service secret (Pattern B) ---
# Long random string shared between your main API and this chat-api. The
# main API sends `X-Service-Secret: <value>` when calling /v1/devices or
# /v1/socket-token on behalf of a user, with an explicit userId in the body.
# Generate with: openssl rand -base64 48
SERVICE_SECRET=

# --- Socket ---
SOCKET_PATH=/socket.io
CORS_ORIGIN=*

# --- FCM (for offline push) ---
# Paste the entire service account JSON as a single-line escaped string, or
# leave blank — push becomes a no-op and chat still works.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# --- Worker ---
UNDELIVERED_TTL_DAYS=14
SWEEP_INTERVAL_SECONDS=300

# --- Uploads ---
# Origin returned in upload URLs. Defaults to the test-deployment IP; change
# to https://chat.yourdomain.com once you put TLS in front.
PUBLIC_BASE_URL=http://156.67.28.84:4100
# Per-kind upload size limits (bytes). Defaults: 15MB images, 10MB voice,
# 50MB generic file.
UPLOAD_MAX_IMAGE_BYTES=15728640
UPLOAD_MAX_VOICE_BYTES=10485760
UPLOAD_MAX_FILE_BYTES=52428800

# How long uploaded files live on disk before the cleanup loop deletes them.
# Aligned with UNDELIVERED_TTL_DAYS (the message-queue TTL) so files don't
# outlive the messages referencing them. Cleanup runs every hour by default.
UPLOAD_FILE_TTL_DAYS=14
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
